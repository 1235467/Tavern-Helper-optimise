{
  "name": "tavern-helper-ng",
  "version": "0.1.0",
  "description": "Rust+WASM-core rewrite of JS-Slash-Runner (Tavern-Helper) \u2014 drop-in ABI-compatible SillyTavern extension, optimized for Firefox desktop & Android",
  "scripts": {
    "build:wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path crates/th-core/Cargo.toml && node tools/opt_wasm.mjs",
    "build:env": "node tools/build_th_env.mjs",
    "build": "pnpm run build:env && vite build",
    "build:full": "pnpm run build:wasm && pnpm run build:env && vite build",
    "watch": "vite build --watch --mode development",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,html,vue}\"",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "node --test 'tests/contract/*.test.mjs' && vitest run --passWithNoTests",
    "test:contract": "node --test 'tests/contract/*.test.mjs'",
    "test:rust": "cd crates/th-core && cargo test",
    "test:watch": "vitest"
  },
  "browserslist": [
    "defaults and partially supports es6-module"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@popperjs/core": "^2.11.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jquery": "^4.0.1",
    "@types/jqueryui": "^1.12.24",
    "@types/lodash": "^4.17.25",
    "@types/showdown": "^2.0.6",
    "@types/sortablejs": "^1.15.9",
    "@types/toastr": "^2.1.44",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/utils": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-pinia": "^0.4.2",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "highlight.js": "^11.12.0",
    "jquery": "^3.7.1",
    "jquery-ui-dist": "^1.13.3",
    "jquery-ui-touch-punch": "^0.2.3",
    "postcss": "^8.5.28",
    "postcss-load-config": "^6.0.1",
    "postcss-minify": "^1.2.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass-embedded": "^1.104.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vanilla-jsoneditor": "^3.13.0",
    "vite": "^8.3.0",
    "vite-plugin-external": "^6.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-router4": "npm:vue-router@^4.5.0",
    "vue-style-loader": "^4.1.3",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@vueuse/components": "^14.4.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/integrations": "^14.4.0",
    "@vueuse/shared": "^14.4.0",
    "async-wait-until": "^2.0.31",
    "compare-versions": "^6.1.1",
    "deep-object-diff": "^1.1.9",
    "destr": "^2.0.5",
    "emittery": "^2.0.0",
    "is-blob": "^3.0.0",
    "is-promise": "^4.0.0",
    "klona": "^2.0.6",
    "lodash-omitdeep": "^1.10.1",
    "object-to-formdata": "^4.5.1",
    "pinia": "^3.0.4",
    "socket.io-client": "^4.8.3",
    "type-fest": "^5.10.0",
    "vue": "^3.5.43",
    "vue-draggable-plus": "^0.6.1",
    "vue-final-modal": "^4.5.5",
    "vue-pick-colors": "^1.8.0",
    "vue-router": "^5.3.1",
    "vue-tippy": "^6.8.0",
    "vue-virt-list": "^1.7.0",
